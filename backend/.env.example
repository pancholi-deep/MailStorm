FRONTEND_URL=http://localhost:3000
# Popup OAuth exchanges use the verified frontend origin. Legacy REDIRECT_URI
# values are no longer used; no callback URL setting is needed.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
HTTP_TIMEOUT=30
MAX_CSV_BYTES=2097152
MAX_RECIPIENTS=500
MAX_BODY_CHARS=1000000
# Use persistent storage in production. Additional origins are comma separated.
# BATCH_DB_PATH=/var/data/mailstorm/batches.sqlite3
# CORS_ORIGINS=https://another-frontend.example.com

# Development uses SQLite and local private uploads. Keep backend/.data private.
APP_ENV=development
EMBEDDED_WORKER=true
# Production requires all of the following, shared by API and worker:
# APP_ENV=production
# EMBEDDED_WORKER=false
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/mailstorm
# CREDENTIAL_ENCRYPTION_KEY=<Fernet key from deployment secret manager>
# S3_BUCKET=private-mailstorm-uploads
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=<optional S3-compatible endpoint>
# Use workload identity or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY for storage.
RETENTION_SECONDS=2592000
SENDER_INTERVAL_SECONDS=1.1
PROJECT_INTERVAL_SECONDS=0.01
